---
import "../styles/global.css";
import { RecordController } from "../components/record-controller.jsx";
import { RecordList } from "../components/records-list/records-list.js";
---

<script>
  import "../backup-service/states/ping-subscription.js";
  import { recordingState } from "../components/states/recording-state.js";

  const originalTitle = document.title;

  recordingState.subscribe((recording) => {
    document.title = recording ? "grabando...." : originalTitle;
  });
</script>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}/recorder-favicon.svg`}
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Recorder</title>
  </head>
  <body>
    <RecordController client:only />

    <RecordList client:only />
  </body>
</html>
