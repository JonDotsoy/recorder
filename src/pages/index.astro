---
import { RecordController } from '../components/record-controller.jsx';
import '../styles/global.css';
---

<script>
	import { recording, type RecordDTO } from "../recorder/db";
	import {
		startScreenRecordingWithAudio,
		createRecordingControl,
	} from "../recorder/recorder";
	import {
		$,
		onClick,
		addClass,
		removeClass,
		setAttribute,
		removeAttribute,
	} from "../components/x-button";
	import { atom } from "nanostores";

	const recordingState = atom({
		recording: false,
	});

	const recordingsState = atom<RecordDTO[]>([]);

	const recordingControl = createRecordingControl();

	onClick($(`#btn-record`), async () => {
		recordingState.set({ recording: true });
		setAttribute($(`#btn-record`), "recording", "true");
		await startScreenRecordingWithAudio(recordingControl);
		removeAttribute($(`#btn-record`), "recording");
		recordingState.set({ recording: false });
	});

	onClick($(`#btn-stop`), async () => {
		await recordingControl.stop();
	});

	recordingsState.subscribe((records) => {
		records.forEach((record) => {
			const li = document.createElement("li");
			li.innerText = record.key;
			$(`#recordings-list`)!.appendChild(li);
		});
	});

	recordingsState.set(await Array.fromAsync(recording.list()));
</script>

<style>
	#btn-record::before {
		content: "grabar";
	}
	#btn-record[recording]::before {
		content: "grabando";
	}
</style>

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body>
		<RecordController client:only></RecordController>

		<ul id="recordings-list"></ul>
	</body>
</html>
